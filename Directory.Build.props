<!-- Root build props for the whole solution -->
<Project>
  <!-- Package Metadata -->
  <PropertyGroup>
    <VersionPrefix>4.3.1</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <Authors>4tecture; .NET Foundation and Contributors</Authors>
    <Copyright>Copyright (c) .NET Foundation and Contributors; modifications Copyright (c) 4tecture</Copyright>
    <Description>4tecture-maintained FIDO2 .NET library without NSec, libsodium, Bouncy Castle, or EdDSA support</Description>
    <RepositoryUrl>https://github.com/4tecture/fido2-net-lib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>fido2 webauthn passkeys system-cryptography</PackageTags>
    <PackageReleaseNotes>Based on upstream Fido2 4.3.1. Removes NSec.Cryptography and libsodium, contains no Bouncy Castle dependency, and disables EdDSA/Ed25519 support.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/4tecture/fido2-net-lib</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  
  <!-- Global Variables -->
  <PropertyGroup>
    <SupportedTargetFrameworks>net8.0;net10.0</SupportedTargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 
      Temporary disabling of CS1591 (Missing XML comment for publicly visible type or member) warning
      Make sure to re-enable it when https://github.com/passwordless-lib/fido2-net-lib/issues/501 is resolved.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  
  <!-- Language + Compiler Settings-->
  <PropertyGroup>
    <LangVersion>13</LangVersion>
  </PropertyGroup>
  
  <!--MISC-->
  <PropertyGroup>
    <!-- Avoid annoying build warnings when packing using the solution file -->
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Avoid annoying build warnings when packing using the solution file -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
</Project>
